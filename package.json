{
  "name": "zen-genome-studio",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "score:height": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-private-pgs.ps1",
    "setup:tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-analysis-tools.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cloudflare": "npm run build && wrangler pages dev",
    "deploy:cloudflare": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "fflate": "^0.8.3",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "wrangler": "latest"
  }
}
