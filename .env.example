# Keep the real value in .env.local. Never commit that file.
GENOME_DATA_DIR=C:\\path\\to\\private-genome-data
GENOME_VCF_NAME=sample.vcf.gz
GENOME_READS_NAME=sample.fastq.genozip
# Optional AncestryDNA raw-data export (.txt or the original .zip).
ANCESTRY_DNA_NAME=AncestryDNA.txt
# Optional relationship of this AncestryDNA sample to the WGS sample: self, mother, father, or parent.
ANCESTRY_DNA_RELATION=self
OPENCRAVAT_URL=http://127.0.0.1:8080
# Optional: override the private derived report location.
# TRAIT_REPORT_PATH=C:\path\outside\the\repository\trait-report.json
# CLINICAL_REPORT_PATH=C:\path\outside\the\repository\clinical-report.json
# ANCESTRY_REPORT_PATH=C:\path\outside\the\repository\ancestry-report.json
