{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zen-genome-studio",
  "compatibility_date": "2026-09-18",
  "pages_build_output_dir": "./dist",
  "r2_buckets": [
    {
      "binding": "GENOME_REPORTS",
      "bucket_name": "zen-genome-studio-private"
    }
  ],
  "send_metrics": false
}
